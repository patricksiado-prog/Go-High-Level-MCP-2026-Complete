# GoHighLevel API Configuration
# This is the DEFAULT sub-account, reached at https://<host>/mcp
GHL_API_KEY=your_private_integration_api_key_here
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_LOCATION_ID=your_location_id_here
GHL_API_VERSION=2021-07-28

# Multi-account / multi-connector support
# ---------------------------------------
# One deployment can serve several GHL sub-accounts. Pick the account from the
# URL (connectors only let you set a URL, not headers):
#   https://<host>/mcp              -> default account below
#   https://<host>/mcp/frontline    -> the "frontline" account
#   https://<host>/mcp/command      -> the "command" account
#
# Optional friendly name for the default account above:
GHL_DEFAULT_ACCOUNT=frontline
#
# Option A: one JSON blob of extra accounts
# GHL_ACCOUNTS={"command":{"apiKey":"pit-xxxx","locationId":"loc_xxxx","label":"Connect & Comm"}}
#
# Option B: flat per-account vars (suffix = account key, uppercased)
# GHL_API_KEY_COMMAND=pit-xxxx
# GHL_LOCATION_ID_COMMAND=loc_xxxx

# Server Configuration
MCP_SERVER_PORT=8000
NODE_ENV=development

# Optional: For AI features
OPENAI_API_KEY=your_openai_key_here_optional
